public/artist-images/*
!public/artist-images/.gitkeep

# mcp config
.mcp.json

# scratch files
wikidata_query.py
.superpowers/

# Claude Code runtime lock (machine-specific)
.claude/scheduled_tasks.lock
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Supabase CLI local link state
supabase/.temp/
supabase/.branches/

# R&D scratch (Pete's raw notes — never committed, see docs/rnd/README.md)
docs/rnd/research/_scratch/*
!docs/rnd/research/_scratch/.gitkeep

# R&D agenda recipients (contact data — public repo)
docs/rnd/recipients.md

# Throwaway debug scripts — never committed.
scripts/_tmp-*

# Discord server layout (internal ops doc — never committed)
docs/discord-layout.md

# Local agent/runtime state — machine-specific, never committed
/.local-data/

# Generated Substack publication captures — keep outside the code repository
/artifacts/substack-profile-update/
